@using Microsoft.AspNetCore.Components.Authorization
@using EmployeeManagement.Blazor.Services

@inject JwtAuthenticationStateProvider AuthenticationStateProvider
@inject ITokenStorageService TokenStorage
@inject NavigationManager Navigation


<AuthorizeView Context="authContext">

    <Authorized>

        <div class="nav-item px-3">

            <NavLink class="nav-link" href="/employees">
                <span class="bi bi-people-fill" aria-hidden="true">
                </span>
                Employees
            </NavLink>
        </div>
        <AuthorizeView Context="designationMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="attendance">
                        <span class="bi bi-building" aria-hidden="true">
                        </span>
                        Attendance
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Context="departmentMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="departments">
                        <span class="bi bi-building" aria-hidden="true">
                        </span>
                        Departments
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Context="designationMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="designations">
                        <span class="bi bi-building" aria-hidden="true">
                        </span>
                        Designations
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="ADMIN"
                       Context="adminContext">

            <div class="nav-item px-3">

                <NavLink class="nav-link"
                         href="/admin">

                    <span class="bi bi-shield-fill"
                          aria-hidden="true">
                    </span>

                    Admin

                </NavLink>

            </div>

        </AuthorizeView>

        <div class="nav-item px-3">

            <button class="btn btn-link nav-link"
                    @onclick="Logout">

                <span class="bi bi-box-arrow-right"
                      aria-hidden="true">
                </span>

                Logout

            </button>

        </div>

    </Authorized>

    <NotAuthorized>

        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/login">

                <span class="bi bi-box-arrow-in-right"
                      aria-hidden="true">
                </span>

                Login

            </NavLink>

        </div>

    </NotAuthorized>

</AuthorizeView>

@code {

    private async Task Logout()
    {
        await TokenStorage.RemoveTokenAsync();

        AuthenticationStateProvider
            .NotifyUserLogout();

        Navigation.NavigateTo(
            "/login",
            replace: true);
    }
}