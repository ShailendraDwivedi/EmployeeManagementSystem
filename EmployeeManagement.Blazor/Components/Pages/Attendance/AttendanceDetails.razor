@page "/attendance/details/{Id:guid}"

@using EmployeeManagement.Blazor.Models.Attendance
@using EmployeeManagement.Blazor.Services.Attendance

@inject IAttendanceService AttendanceService
@inject NavigationManager Navigation

<PageTitle>Attendance Details</PageTitle>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">
        @ErrorMessage
    </div>
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>
            <i class="bi bi-calendar-check me-2"></i>
            Attendance Details
        </h3>

        <button class="btn btn-secondary"
                @onclick="GoBack">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </button>

    </div>


    @if (IsLoading)
    {
        <div class="text-center p-5">

            <div class="spinner-border text-primary">
            </div>

            <div class="mt-2">
                Loading attendance...
            </div>

        </div>
    }
    else if (Attendance == null)
    {
        <div class="alert alert-warning">
            Attendance record not found.
        </div>
    }
    else
    {
        <div class="row">

            <!-- Employee Information -->

            <div class="col-md-6 mb-4">

                <div class="card h-100">

                    <div class="card-header">
                        <strong>
                            Employee Information
                        </strong>
                    </div>

                    <div class="card-body">
                        <div class="mb-3">

                            <label class="text-muted">
                                Employee Code
                            </label>

                            <h5>
                                @Attendance.EmployeeCode
                            </h5>

                        </div>

                        <div class="mb-3">

                            <label class="text-muted">
                                Employee
                            </label>

                            <h5>
                                @Attendance.EmployeeName
                            </h5>

                        </div>

                        <div class="mb-3">

                            <label class="text-muted">
                                Employee ID
                            </label>

                            <div>
                                @Attendance.EmployeeId
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Attendance Information -->

            <div class="col-md-6 mb-4">

                <div class="card h-100">

                    <div class="card-header">
                        <strong>
                            Attendance Information
                        </strong>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="text-muted">
                                    Check In
                                </label>

                                <div class="fw-bold">
                                    @Attendance.CheckIn.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")
                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label class="text-muted">
                                    Check Out
                                </label>

                                <div class="fw-bold">

                                    @if (Attendance.CheckOut.HasValue)
                                    {
                                        @Attendance.CheckOut.Value.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-warning">
                                            Not Checked Out
                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label class="text-muted">
                                    Working Hours
                                </label>

                                <div class="fw-bold">

                                    @if (Attendance.WorkingHours.HasValue)
                                    {
                                        @($"{Attendance.WorkingHours.Value:0.00} Hours")
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label class="text-muted">
                                    Status
                                </label>
                                <div>
                                    <span class="badge @GetStatusCssClass(Attendance?.Status)">
                                        @GetStatusText(Attendance?.Status)
                                    </span>
                                    <span class="badge""></span>
                                    @if (Attendance!.CheckOut.HasValue)
                                    {
                                        <span class="badge bg-success">
                                            Checked Out
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Checked In
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Actions -->

        <div class="card">

            <div class="card-body">

                @if (!Attendance.CheckOut.HasValue)
                {
                    <button class="btn btn-danger"
                            @onclick="CheckOutAsync"
                            disabled="@IsCheckingOut">

                        @if (IsCheckingOut)
                        {
                            <span class="spinner-border spinner-border-sm me-2">  Checking Out...</span>

                        }
                        else
                        {
                            <i class="bi bi-box-arrow-right me-1"> Check Out</i>

                        }

                    </button>
                }

                <button class="btn btn-outline-primary ms-2"
                        @onclick="ViewEmployeeHistory">

                    <i class="bi bi-clock-history me-1"></i>
                    Employee History

                </button>

            </div>

        </div>
    }

</div>
@code {

    [Parameter]
    public Guid Id { get; set; }

    private AttendanceDto? Attendance;

    private bool IsLoading;

    private bool IsCheckingOut;

    private string ErrorMessage = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await LoadAttendanceAsync();
    }


    private async Task LoadAttendanceAsync()
    {
        try
        {
            IsLoading = true;

            ErrorMessage = string.Empty;

            Attendance = await AttendanceService.GetAttendanceByIdAsync(Id);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task CheckOutAsync()
    {
        if (Attendance == null)
            return;

        try
        {
            IsCheckingOut = true;

            ErrorMessage = string.Empty;

            var success = await AttendanceService.CheckOutAsync(Attendance.AttendanceId);

            if (success)
            {
                await LoadAttendanceAsync();
            }
            else
            {
                ErrorMessage = "Unable to check out employee.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsCheckingOut = false;
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/attendance");
    }


    private void ViewEmployeeHistory()
    {
        if (Attendance == null)
            return;

        Navigation.NavigateTo($"/attendance/employee/{Attendance.EmployeeId}");
    }
    private string GetStatusText(int? status)
    {
        return status switch
        {
            0 => "Present",
            1 => "Absent",
            2 => "Late",
            3 => "Leave",
            _ => "Unknown"
        };
    }

    private string GetStatusCssClass(int? status)
    {
        return status switch
        {
            0 => "bg-success",
            1 => "bg-danger",
            2 => "bg-warning text-dark",
            3 => "bg-info",
            _ => "bg-secondary"
        };
    }
}