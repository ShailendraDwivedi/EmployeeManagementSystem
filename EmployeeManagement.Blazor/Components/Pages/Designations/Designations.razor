@page "/designations"

@rendermode InteractiveServer
@using EmployeeManagement.Blazor.Components.Shared
@using EmployeeManagement.Blazor.Models
@using EmployeeManagement.Blazor.Models.DesignationModels
@using EmployeeManagement.Blazor.Services
@using EmployeeManagement.Blazor.Services.Designation
@using Microsoft.AspNetCore.Components.Authorization

@inject IDesignationService DesignationService
@inject NavigationManager Navigation

@inject IJSRuntime JS


<PageTitle>Designations</PageTitle>

<div class="d-flex justify-content-between
            align-items-center mb-3">

    <h3>Designations</h3>

    <AuthorizeView Roles="ADMIN"
                   Context="createContext">

        <button class="btn btn-primary"
                @onclick="CreateDesignation">

            Add Designation

        </button>

    </AuthorizeView>

</div>

<ErrorAlert Message="@errorMessage" />

<div class="row mb-3">

    <div class="col-md-6">

        <label class="form-label">
            Search Designation
        </label>

        <input class="form-control"
               placeholder="Search designation..."
               @bind="searchText"
               @bind:event="oninput" />

    </div>

    <div class="col-md-2">

        <label class="form-label">
            Page Size
        </label>

        <select class="form-select"
                value="@pageSize"
                @onchange="PageSizeChanged">

            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>

        </select>

    </div>

    <div class="col-md-4 d-flex
                align-items-end">

        <button class="btn btn-primary me-2"
                @onclick="SearchDesignations">

            Search

        </button>

        <button class="btn btn-secondary"
                @onclick="ClearSearch">

            Clear

        </button>

    </div>

</div>

@if (isLoading)
{
    <LoadingSpinner Message="Loading designations..." />
}
else if (designationResult.Items.Any())
{
    <table class="table table-bordered
                                      table-striped">

        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var designation
                    in designationResult.Items)
            {
                <tr>

                    <td>
                        @designation.Name
                    </td>

                    <td>
                        @designation.Description
                    </td>

                    <td>

                        @if (designation.IsActive == true)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </td>

                    <td>

                        <button class="btn btn-sm btn-info me-1"
                                @onclick="() =>
                                ViewDesignation(designation.Id)">

                    View

                        </button>

                        <AuthorizeView Roles="ADMIN"
                                       Context="adminContext">

                            <button class="btn btn-sm btn-warning me-1"
                                    @onclick="() =>
                                                                                                                                                                                        EditDesignation(
                                                                                                                                                                                            designation.Id)">

                        Edit

                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() =>
                                                                                                                                                                                                                    ConfirmDelete(
                                                                                                                                                                                            designation.Id)">

                        Delete

                            </button>

                        </AuthorizeView>

                    </td>

                </tr>
                }

        </tbody>

    </table>
}
else
{
    <EmptyState Title="No Designations Found"
                Message="No designation match your search." />
}

@if (designationResult.TotalPages > 1)
{
    <div class="d-flex
                                    justify-content-between
                                    align-items-center mt-3">

        <div>
            Showing
            @(
                    designationResult.TotalCount == 0
                    ? 0
                    : ((currentPage - 1) * pageSize) + 1
                    )
            -
            @(
                    Math.Min(
                    currentPage * pageSize,
                    designationResult.TotalCount)
                    )
        of
        @designationResult.TotalCount
    </div>

        <div>

            <button class="btn btn-outline-primary me-2"
                    disabled="@(currentPage <= 1)"
                    @onclick="PreviousPage">

                Previous

            </button>

            <span class="mx-2">
                Page @currentPage
                of @designationResult.TotalPages
            </span>

            <button class="btn btn-outline-primary"
                    disabled="@(currentPage >=
                                                                                                            designationResult.TotalPages)"
                @onclick="NextPage">

                Next

            </button>

        </div>

    </div>
                }


@code {

    private PagedResult<DesignationDto>
        designationResult = new();

    private bool isLoading = true;

    private string errorMessage = string.Empty;

    private string searchText = string.Empty;

    private int currentPage = 1;

    private int pageSize = 10;


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadDesignations();

        StateHasChanged();
    }


    private async Task LoadDesignations()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            designationResult =
                await DesignationService
                    .GetDesignationsAsync(
                        currentPage,
                        pageSize,
                        searchText);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load designation: " +
                $"{ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SearchDesignations()
    {
        currentPage = 1;

        await LoadDesignations();
    }


    private async Task ClearSearch()
    {
        searchText = string.Empty;

        currentPage = 1;

        await LoadDesignations();
    }


    private async Task PreviousPage()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;

        await LoadDesignations();
    }


    private async Task NextPage()
    {
        if (currentPage >=
            designationResult.TotalPages)
        {
            return;
        }

        currentPage++;

        await LoadDesignations();
    }


    private async Task PageSizeChanged(
        ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newPageSize))
        {
            pageSize = newPageSize;

            currentPage = 1;

            await LoadDesignations();
        }
    }


    private void CreateDesignation()
    {
        Navigation.NavigateTo(
            "/designations/create");
    }


    private void ViewDesignation(Guid id)
    {
        Navigation.NavigateTo(
            $"/designations/details/{id}");
    }


    private void EditDesignation(Guid id)
    {
        Navigation.NavigateTo(
            $"/designations/edit/{id}");
    }

    private async Task ConfirmDelete(Guid id)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                "Are you sure you want to delete this designation?");

        if (!confirmed)
        {
            return;
        }

        await DeleteDesignation(id);
    }
    private async Task DeleteDesignation(Guid id)
    {
        try
        {
            errorMessage = string.Empty;

            await DesignationService 
                .DeleteDesignationAsync(id);

            await LoadDesignations();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to delete designation: {ex.Message}";
        }
    }
}