<div class="alert alert-info text-center">
    <h5>@Title</h5>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="mb-0">
            @Message
        </p>
    }
</div>

@code {

    [Parameter]
    public string Title { get; set; }
        = "No records found.";

    [Parameter]
    public string? Message { get; set; }

}